{
  "name": "enhome",
  "version": "3.2.0",
  "private": true,
  "description": "App de escritorio personal para aprender inglés, impulsada por Claude Code.",
  "author": "Artemis18",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "update-local": "node scripts/update-local.cjs",
    "icon": "electron scripts/make-icon.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "electron-vite build && node --test --test-concurrency=1 tests/e2e/app.e2e.mjs",
    "content:check": "vitest run tests/content",
    "content:banks": "node scripts/run-ts.mjs scripts/banks.ts",
    "content:chunks": "node scripts/run-ts.mjs scripts/chunks.ts",
    "content:syllabus": "node scripts/run-ts.mjs scripts/syllabus.ts",
    "content:topics": "node scripts/run-ts.mjs scripts/topics.ts",
    "content:placement": "node scripts/run-ts.mjs scripts/placement.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "postinstall": "node node_modules/electron/install.js",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "sherpa-onnx-node": "^1.13.8",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.55.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
